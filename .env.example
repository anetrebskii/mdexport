# GitHub: https://github.com/settings/tokens (classic, repo scope)
GITHUB_TOKEN=ghp_...

# Slack: Create app at https://api.slack.com/apps -> OAuth & Permissions
# Required user token scopes: channels:history, channels:read, groups:history, groups:read, users:read
SLACK_TOKEN=xoxp-...

# Linear: https://linear.app/settings/api -> Personal API keys
LINEAR_TOKEN=lin_api_...

# Google Docs: Use a service account key file (--service-account-key) or an OAuth token
# Service account: https://console.cloud.google.com/iam-admin/serviceaccounts
# OAuth token: obtain via gcloud or OAuth flow
GOOGLE_TOKEN=ya29....

# Notion: https://www.notion.so/my-integrations -> Create integration (read content capability)
# Share pages/databases with the integration to make them accessible
NOTION_TOKEN=ntn_...
