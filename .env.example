# GitHub: https://github.com/settings/tokens (classic, repo scope)
GITHUB_TOKEN=ghp_...

# Slack: Create app at https://api.slack.com/apps -> OAuth & Permissions
# Required user token scopes: channels:history, channels:read, groups:history, groups:read, users:read
SLACK_TOKEN=xoxp-...

# Linear: https://linear.app/settings/api -> Personal API keys
LINEAR_TOKEN=lin_api_...
